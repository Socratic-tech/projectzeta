/************************************************************
 * VOCATIONAL TRACKER LOADER (loader __LOADER__)
 *
 * Paste this ONE file into Apps Script as Code.gs (replace the
 * whole file), keep Sidebar.html as it is, and run vtbInstallNow once.
 * After that, backend updates arrive with one "Update now" click
 * (Admin page, or Vocational Tracker menu in the Sheet) and can be
 * undone with one click.
 *
 * What this file does
 * -------------------
 *  - Downloads the backend (bundle.js) from the tracker website.
 *  - Installs it ONLY if (1) its SHA-256 matches the hash published in
 *    version.json, (2) it compiles, (3) it exposes the required
 *    functions, and (4) it answers a liveness check on this Sheet.
 *    Otherwise the Sheet keeps the version it already has.
 *  - Keeps the version it replaced, so "Undo last update" puts it back.
 *  - Hands every web request and every Sidebar call to the installed
 *    backend. Student data, codes and QR links are never touched.
 *
 * Updates are never automatic. An administrator (or a spreadsheet
 * editor, from the menu) must click Update now.
 *
 * Do not edit this file by hand. It is generated by tools/build-backend.js.
 ************************************************************/

var VT_LOADER = { site: "__SITE__", loader: __LOADER__ };

var VTB_CHUNK_ = 3000;          // characters per stored chunk (Script Properties cap values at 9 KB)
var VTB_MAX_CHARS_ = 200000;    // largest backend this loader will store (two copies must fit in 500 KB)
var VTB_REQUIRED_ = ["doGet", "doPost", "onOpen", "ensureInstanceReady_",
                     "requireAdmin_", "okReply", "denied", "jsonReply"];
var VTB_MEMO_ = null;           // compiled backend, reused within one execution


/************************************************************
 * SMALL HELPERS
 ************************************************************/

function vtbJson_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function vtbSha256_(text) {
  var bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256, String(text), Utilities.Charset.UTF_8);
  return bytes.map(function (b) {
    if (b < 0) b += 256;
    return ("0" + b.toString(16)).slice(-2);
  }).join("");
}

function vtbWithLock_(fn) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try { return fn(); } finally { lock.releaseLock(); }
}


/************************************************************
 * STORAGE (Script Properties; two slots: CUR and PREV)
 ************************************************************/

function vtbKey_(slot, part) { return "VTB_" + slot + "_" + part; }

function vtbSlotRead_(slot) {
  var all = PropertiesService.getScriptProperties().getProperties();
  var raw = all[vtbKey_(slot, "META")];
  if (!raw) return null;

  var meta;
  try { meta = JSON.parse(raw); } catch (err) { return null; }
  if (!meta || !meta.chunks) return null;

  var parts = [];
  for (var i = 0; i < meta.chunks; i++) {
    var piece = all[vtbKey_(slot, i)];
    if (piece === undefined) return null;
    parts.push(piece);
  }

  var code = parts.join("");
  if (vtbSha256_(code) !== meta.sha256) return null;   // damaged copy: never run it

  meta.code = code;
  return meta;
}

function vtbSlotWrite_(slot, bundle) {
  var props = PropertiesService.getScriptProperties();
  var all = props.getProperties();

  if (bundle.code.length > VTB_MAX_CHARS_) {
    throw new Error("This backend is too large for the loader to store.");
  }

  var oldMeta = null;
  try { oldMeta = JSON.parse(all[vtbKey_(slot, "META")] || "null"); } catch (err) { oldMeta = null; }

  var chunks = Math.ceil(bundle.code.length / VTB_CHUNK_);
  var out = {};
  for (var i = 0; i < chunks; i++) {
    out[vtbKey_(slot, i)] = bundle.code.substr(i * VTB_CHUNK_, VTB_CHUNK_);
  }

  // Chunks first, META last: a half-finished write has no valid META hash.
  props.deleteProperty(vtbKey_(slot, "META"));
  props.setProperties(out, false);

  if (oldMeta && oldMeta.chunks > chunks) {
    for (var j = chunks; j < oldMeta.chunks; j++) props.deleteProperty(vtbKey_(slot, j));
  }

  props.setProperty(vtbKey_(slot, "META"), JSON.stringify({
    version: bundle.version,
    sha256: bundle.sha256,
    chunks: chunks,
    installedAt: bundle.installedAt || new Date().toISOString(),
    installedBy: bundle.installedBy || ""
  }));
}


/************************************************************
 * COMPILE + CHECK
 ************************************************************/

function vtbCompile_(code) {
  var api = new Function(code)();
  if (!api || typeof api !== "object") throw new Error("The backend did not load.");
  return api;
}

function vtbCheckApi_(api, expectVersion) {
  VTB_REQUIRED_.forEach(function (name) {
    if (typeof api[name] !== "function") {
      throw new Error("The new backend is missing " + name + ".");
    }
  });

  if (!(api.VT_API_VERSION >= 3)) throw new Error("The new backend does not report API v3 or newer.");
  if (expectVersion && api.VT_RELEASE !== expectVersion) {
    throw new Error("The new backend says it is version " + api.VT_RELEASE + ", not " + expectVersion + ".");
  }

  // Liveness check against THIS Sheet (read-only).
  var reply = JSON.parse(api.doGet({}).getContent());
  if (reply.status !== "online") throw new Error("The new backend did not start on this Sheet.");
}

/** The installed backend (falls back to the previous copy if the current one is damaged). */
function vtbCurrent_() {
  if (VTB_MEMO_) return VTB_MEMO_;
  var bundle = vtbSlotRead_("CUR") || vtbSlotRead_("PREV");
  if (!bundle) return null;
  VTB_MEMO_ = { api: vtbCompile_(bundle.code), bundle: bundle };
  return VTB_MEMO_;
}

/** The backend for a request; installs the latest one the very first time. */
function vtbApi_() {
  var cur = vtbCurrent_();
  if (cur) return cur.api;

  vtbInstallLatest_("first install");
  cur = vtbCurrent_();
  if (!cur) throw new Error("The backend is not installed.");
  return cur.api;
}


/************************************************************
 * LATEST VERSION (from the website)
 ************************************************************/

function vtbFetchText_(path) {
  var url = VT_LOADER.site + path + (path.indexOf("?") < 0 ? "?" : "&") + "t=" + new Date().getTime();
  var res = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
  if (res.getResponseCode() !== 200) {
    throw new Error("Could not download " + path + " (HTTP " + res.getResponseCode() + ").");
  }
  return res.getContentText("UTF-8");
}

function vtbFetchLatest_() {
  var v = JSON.parse(vtbFetchText_("backend/version.json"));

  if (!v || !/^[\w.\-]{1,40}$/.test(String(v.version || ""))) throw new Error("version.json has no valid version.");
  if (!/^[0-9a-f]{64}$/.test(String(v.sha256 || ""))) throw new Error("version.json has no valid hash.");

  return {
    version: String(v.version),
    sha256: String(v.sha256),
    date: String(v.date || ""),
    notes: String(v.notes || ""),
    changes: Array.isArray(v.changes) ? v.changes.map(String).slice(0, 12) : [],
    minLoader: Number(v.minLoader || 1)
  };
}


/************************************************************
 * INSTALL / UNDO / STATUS
 ************************************************************/

/**
 * Downloads, verifies and installs the latest backend.
 * Throws (and changes nothing) if any check fails.
 */
function vtbInstallLatest_(who) {
  return vtbWithLock_(function () {
    var latest = vtbFetchLatest_();

    if (latest.minLoader > VT_LOADER.loader) {
      throw new Error("This release needs a newer loader. Paste the current Loader code from the setup page, then try again.");
    }

    var code = vtbFetchText_("backend/bundle.js?v=" + encodeURIComponent(latest.version));

    if (vtbSha256_(code) !== latest.sha256) {
      throw new Error("The download did not match its published fingerprint, so it was NOT installed.");
    }

    var firstLine = code.split("\n", 1)[0];
    if (firstLine.indexOf("// Vocational Tracker backend " + latest.version) !== 0) {
      throw new Error("The download is not version " + latest.version + ", so it was NOT installed.");
    }

    // Compile and test it before anything is replaced.
    var api = vtbCompile_(code);
    vtbCheckApi_(api, latest.version);

    var current = vtbSlotRead_("CUR");
    if (current && current.version === latest.version && current.sha256 === latest.sha256) {
      return { version: latest.version, previous: null, unchanged: true };
    }

    // Keep what we are replacing so it can be undone.
    if (current) vtbSlotWrite_("PREV", current);

    vtbSlotWrite_("CUR", {
      version: latest.version,
      sha256: latest.sha256,
      code: code,
      installedAt: new Date().toISOString(),
      installedBy: String(who || "")
    });

    PropertiesService.getScriptProperties().deleteProperty("VTB_UNDONE");
    VTB_MEMO_ = null;

    return { version: latest.version, previous: current ? current.version : null, unchanged: false };
  });
}

/** Swaps the current and previous versions. Pressing it twice redoes the update. */
function vtbUndo_(who) {
  return vtbWithLock_(function () {
    var prev = vtbSlotRead_("PREV");
    if (!prev) throw new Error("There is no earlier version to go back to.");

    var cur = vtbSlotRead_("CUR");

    vtbCheckApi_(vtbCompile_(prev.code), prev.version);   // never restore something that no longer runs

    var props = PropertiesService.getScriptProperties();
    var undone = props.getProperty("VTB_UNDONE");

    if (cur) vtbSlotWrite_("PREV", cur);
    vtbSlotWrite_("CUR", {
      version: prev.version,
      sha256: prev.sha256,
      code: prev.code,
      installedAt: new Date().toISOString(),
      installedBy: String(who || "")
    });

    // Remember which version was undone so the update prompt does not nag.
    // Going back "forward" (a redo) clears it.
    if (cur && undone !== prev.version) props.setProperty("VTB_UNDONE", cur.version);
    else props.deleteProperty("VTB_UNDONE");

    VTB_MEMO_ = null;
    return { version: prev.version, previous: cur ? cur.version : null };
  });
}

function vtbStatus_() {
  var cur = vtbSlotRead_("CUR") || vtbSlotRead_("PREV");
  var prev = vtbSlotRead_("PREV");
  var undone = PropertiesService.getScriptProperties().getProperty("VTB_UNDONE") || "";

  var latest = null;
  var latestError = "";
  try { latest = vtbFetchLatest_(); } catch (err) { latestError = err && err.message ? err.message : String(err); }

  return {
    loader: VT_LOADER.loader,
    installed: cur ? cur.version : "",
    installedAt: cur ? cur.installedAt : "",
    installedBy: cur ? cur.installedBy : "",
    previous: prev && cur && prev.version !== cur.version ? prev.version : "",
    canUndo: !!(prev && cur && prev.version !== cur.version),
    undone: undone,
    latest: latest,
    latestError: latestError,
    updateAvailable: !!(latest && (!cur || latest.version !== cur.version) && latest.version !== undone)
  };
}


/************************************************************
 * WEB ENTRY POINTS
 *
 * Everything is passed to the installed backend, except the three
 * update routes below, which are handled here so a backend release
 * can never remove its own undo.
 ************************************************************/

function doGet(e) {
  try {
    return vtbApi_().doGet(e);
  } catch (err) {
    return vtbJson_({ status: "error", message: "Backend not installed: " + (err && err.message ? err.message : err) });
  }
}

function doPost(e) {
  try {
    var d = {};
    if (e && e.postData && e.postData.contents) {
      try { d = JSON.parse(e.postData.contents); } catch (err) { d = {}; }
    }

    if (d.action === "updateStatus" || d.action === "installUpdate" || d.action === "undoUpdate") {
      return vtbAdminRoute_(d);
    }

    return vtbApi_().doPost(e);
  } catch (err) {
    return vtbJson_({ status: "error", message: err && err.message ? err.message : String(err) });
  }
}

function vtbAdminRoute_(d) {
  var cur = vtbCurrent_();
  if (!cur) {
    return vtbJson_({
      status: "error",
      message: "The backend is not installed yet. In the Sheet choose Vocational Tracker → Check for updates."
    });
  }

  var api = cur.api;
  var admin = api.requireAdmin_(d);
  if (!admin) return api.denied("Incorrect or inactive administrator code.");

  if (d.action === "updateStatus") {
    return api.okReply({ update: vtbStatus_() });
  }

  if (d.action === "installUpdate") {
    var latest = vtbFetchLatest_();
    // The administrator approved a specific release; refuse if it changed since.
    if (!d.expectVersion || String(d.expectVersion) !== latest.version) {
      return api.jsonReply({
        status: "error",
        apiVersion: api.VT_API_VERSION,
        code: "changed",
        message: "A different release is now available than the one you reviewed. Reload the page and review it first."
      });
    }
    var done = vtbInstallLatest_(admin.name || "Administrator");
    return api.okReply({ installed: done, update: vtbStatus_() });
  }

  var undone = vtbUndo_(admin.name || "Administrator");
  return api.okReply({ undone: undone, update: vtbStatus_() });
}


/************************************************************
 * SPREADSHEET MENU
 ************************************************************/

function onOpen(e) {
  try {
    var cur = vtbCurrent_();
    if (cur) cur.api.ensureInstanceReady_();
  } catch (err) {
    console.error("Vocational Tracker initialization failed:", err);
  }

  SpreadsheetApp.getUi()
    .createMenu("Vocational Tracker")
    .addItem("Setup & Credentials", "showSetupSidebar")
    .addSeparator()
    .addItem("Repair / Check Setup", "initialSetup")
    .addSeparator()
    .addItem("Check for updates", "vtbMenuCheck")
    .addItem("Undo last update", "vtbMenuUndo")
    .addToUi();
}

function vtbMenuCheck() {
  var ui = SpreadsheetApp.getUi();
  var st = vtbStatus_();

  if (st.latestError) {
    ui.alert("Could not check for updates", st.latestError, ui.ButtonSet.OK);
    return;
  }

  if (!st.updateAvailable) {
    ui.alert("Vocational Tracker is up to date",
      "Installed version: " + (st.installed || "none") + "." +
      (st.undone ? "\n\nYou undid version " + st.undone + ". It will not be offered again until a newer release is published." : ""),
      ui.ButtonSet.OK);
    return;
  }

  var lines = "Installed: " + (st.installed || "none") + "\nAvailable: " + st.latest.version +
    (st.latest.date ? " (" + st.latest.date + ")" : "") + "\n\n" + st.latest.notes +
    "\n\nStudent data, codes and QR links are not affected. You can undo the update afterward.";
  if (ui.alert("Install the update?", lines, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;

  try {
    var done = vtbInstallLatest_("Spreadsheet editor");
    ui.alert("Updated", "Vocational Tracker is now version " + done.version + ".", ui.ButtonSet.OK);
  } catch (err) {
    ui.alert("Update not installed", (err && err.message ? err.message : String(err)) + "\n\nNothing was changed.", ui.ButtonSet.OK);
  }
}

function vtbMenuUndo() {
  var ui = SpreadsheetApp.getUi();
  var st = vtbStatus_();

  if (!st.canUndo) {
    ui.alert("Nothing to undo", "There is no earlier version stored.", ui.ButtonSet.OK);
    return;
  }

  if (ui.alert("Undo the last update?",
      "Go back from " + st.installed + " to " + st.previous + ". Student data is not affected.",
      ui.ButtonSet.YES_NO) !== ui.Button.YES) return;

  try {
    var done = vtbUndo_("Spreadsheet editor");
    ui.alert("Done", "Vocational Tracker is back on version " + done.version + ".", ui.ButtonSet.OK);
  } catch (err) {
    ui.alert("Could not undo", (err && err.message ? err.message : String(err)), ui.ButtonSet.OK);
  }
}


/************************************************************
 * EDITOR-ONLY: run once after pasting this file
 *
 * Running this from the Apps Script editor asks Google for the
 * permission to download from the website, then installs the backend.
 ************************************************************/

function vtbInstallNow() {
  var done = vtbInstallLatest_("Spreadsheet editor");
  Logger.log("Installed Vocational Tracker backend " + done.version +
    (done.unchanged ? " (already current)" : "") + ".");
  Logger.log("Now choose Deploy > Manage deployments > pencil > New version > Deploy (once).");
}

function vtbShowStatus() {
  Logger.log(JSON.stringify(vtbStatus_(), null, 2));
}


